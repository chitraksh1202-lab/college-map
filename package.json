{
  "name": "college-explorer",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "format": "prettier --write .",
    "data:import": "tsx scripts/import-college-scorecard.ts && tsx scripts/import-global-institutions.ts && tsx scripts/merge-global-dataset.ts",
    "data:import:us": "tsx scripts/import-college-scorecard.ts",
    "data:import:global": "tsx scripts/import-global-institutions.ts",
    "data:merge": "tsx scripts/merge-global-dataset.ts",
    "data:check": "tsx scripts/data-check.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^5.1.5",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/stream-chain": "^2.1.0",
    "@types/stream-json": "^1.7.8",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "adm-zip": "^0.6.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "stream-json": "^1.9.1",
    "tsx": "^4.19.2",
    "vitest": "^5.0.1"
  }
}
