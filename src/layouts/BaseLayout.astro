---
import Header from "@/components/Header.astro";
import { BRAND_NAME } from "@/lib/site";
import "@/styles/global.css";

type Props = {
  title: string;
  description?: string;
  /** JSON-LD object (e.g. schema.org CollegeOrUniversity) — only pass honestly-mapped fields. */
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
};

const {
  title,
  description = "Explore US colleges like places, not rankings.",
  structuredData,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/favicon.svg", Astro.site).toString()} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="min-h-screen bg-sand-50">
    <Header />
    <main>
      <slot />
    </main>
    <script>
      // Tiny, reusable click-tracking convention: any element with
      // data-track="<event name>" fires that analytics event on click,
      // with data-track-<x> attributes passed through as event props.
      // One delegated listener here means individual components (Astro
      // or React) never need to import/wire analytics themselves for a
      // simple "this was clicked" event — see src/lib/analytics.ts.
      import { track, type AnalyticsEvent } from "@/lib/analytics";

      document.addEventListener("click", (event) => {
        const el = (event.target as HTMLElement)?.closest<HTMLElement>("[data-track]");
        if (!el) return;
        const name = el.getAttribute("data-track");
        if (!name) return;
        const props: Record<string, string> = {};
        for (const attr of Array.from(el.attributes)) {
          if (attr.name.startsWith("data-track-")) {
            props[attr.name.replace("data-track-", "")] = attr.value;
          }
        }
        track(name as AnalyticsEvent, props);
      });
    </script>
  </body>
</html>
