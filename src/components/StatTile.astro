---
type Props = {
  label: string;
  value: string;
  href?: string;
};

const { label, value, href } = Astro.props;
---

<div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
  <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">{label}</dt>
  <dd class="mt-1 text-lg font-semibold text-slate-800">
    {
      href ? (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-horizon-600 hover:underline"
        >
          Visit site ↗
        </a>
      ) : (
        value
      )
    }
  </dd>
</div>
