---
type Props = {
  label: string;
  value: string;
  href?: string;
  /** Short plain-language explanation shown as a native tooltip on hover/focus. */
  hint?: string;
};

const { label, value, href, hint } = Astro.props;
---

<div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
  <dt class="text-xs font-medium uppercase tracking-wide text-slate-400" title={hint}>
    {label}
    {hint && <span aria-hidden="true" class="ml-0.5 cursor-help text-slate-300">ⓘ</span>}
  </dt>
  <dd class="mt-1 text-lg font-semibold text-slate-800">
    {
      href ? (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-horizon-600 hover:underline"
        >
          Visit site ↗
        </a>
      ) : (
        value
      )
    }
  </dd>
</div>
