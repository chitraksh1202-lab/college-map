---
import type { CampusTourPoint } from "@/lib/types";

type Props = {
  collegeName: string;
  fallbackLatitude: number;
  fallbackLongitude: number;
  tourPoints?: CampusTourPoint[];
};

const { collegeName, fallbackLatitude, fallbackLongitude, tourPoints = [] } = Astro.props;

const embedKey = import.meta.env.PUBLIC_GOOGLE_MAPS_EMBED_KEY;

const points: CampusTourPoint[] =
  tourPoints.length > 0
    ? tourPoints
    : [
        {
          id: "campus-center",
          name: `${collegeName} campus`,
          latitude: fallbackLatitude,
          longitude: fallbackLongitude,
          category: "landmark",
        },
      ];

function streetViewSrc(point: CampusTourPoint): string {
  const params = new URLSearchParams({
    key: embedKey ?? "",
    location: `${point.latitude},${point.longitude}`,
  });
  return `https://www.google.com/maps/embed/v1/streetview?${params.toString()}`;
}
---

<section aria-labelledby="explore-campus-heading" class="space-y-5">
  <h2 id="explore-campus-heading" class="scroll-mt-24 font-display text-2xl font-semibold text-ink-900">
    Explore campus
  </h2>

  <div class:list={["grid gap-5", points.length > 1 && "md:grid-cols-[13rem_1fr]"]}>
    {
      points.length > 1 && (
        <div
          aria-label="Campus stops"
          class="flex gap-2 overflow-x-auto pb-1 md:flex-col md:overflow-visible md:pb-0"
        >
          {points.map((point, index) => (
            <button
              type="button"
              class="tour-point-button shrink-0 rounded-2xl border border-stone-200 bg-white px-4 py-2.5 text-left text-sm font-medium text-ink-700 transition hover:border-ember-300 aria-pressed:border-ember-400 aria-pressed:bg-ember-50 aria-pressed:text-ember-700"
              data-src={streetViewSrc(point)}
              data-name={point.name}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span class="block truncate">{point.name}</span>
              {point.unverified && <span class="text-xs text-stone-400">approximate location</span>}
            </button>
          ))}
        </div>
      )
    }

    <div>
      {
        !embedKey ? (
          <div
            id="street-view-fallback"
            class="flex h-[380px] flex-col items-center justify-center rounded-3xl border border-stone-200 bg-sand-100 p-8 text-center md:h-[440px]"
          >
            <p class="font-display text-lg text-ink-700">
              Street View for <span id="street-view-fallback-name">{points[0].name}</span> is coming soon.
            </p>
            <p class="mt-2 max-w-sm text-sm text-ink-500">
              We're still connecting this campus to Google Street View — check back shortly.
            </p>
          </div>
        ) : (
          <div class="overflow-hidden rounded-3xl border border-stone-200 shadow-soft">
            <iframe
              id="street-view-frame"
              class="h-[380px] w-full md:h-[440px]"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              src={streetViewSrc(points[0])}
              title={`Street View of ${collegeName}`}
            />
          </div>
        )
      }

      {
        points.some((p) => p.unverified) && (
          <p class="mt-3 text-xs text-ink-500/70">
            Coordinates for these stops are approximate and pending manual verification.
          </p>
        )
      }
    </div>
  </div>
</section>

<script>
  // Selection state (aria-pressed, fallback label) updates regardless of
  // whether a Street View embed key is configured — only the iframe src
  // update depends on the iframe actually existing.
  const frame = document.getElementById("street-view-frame") as HTMLIFrameElement | null;
  const fallbackName = document.getElementById("street-view-fallback-name");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tour-point-button");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      button.setAttribute("aria-pressed", "true");

      if (frame && button.dataset.src) {
        frame.src = button.dataset.src;
      }
      if (fallbackName && button.dataset.name) {
        fallbackName.textContent = button.dataset.name;
      }
    });
  });
</script>
