---
type Props = { title: string; id?: string; supporting?: string };
const { title, id, supporting } = Astro.props;
---

<div class="mb-4">
  <h2 id={id} class="font-display text-2xl font-semibold text-ink-900">{title}</h2>
  {supporting && <p class="mt-1 text-sm text-ink-500">{supporting}</p>}
</div>
