---
import { BRAND_NAME } from "@/lib/site";

const currentPath = Astro.url.pathname;
function isActive(path: string) {
  return path === "/" ? currentPath === "/" : currentPath.startsWith(path);
}
---

<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-sand-50/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 md:px-8">
    <a href="/" class="font-display text-[1.15rem] font-semibold tracking-tight text-ink-900">
      {BRAND_NAME.split(" ")[0]}<span class="text-ember-500">{BRAND_NAME.split(" ").slice(1).join(" ")}</span>
    </a>
    <nav class="flex items-center gap-1 text-[0.9rem] font-medium text-ink-700">
      <a
        href="/"
        class:list={[
          "rounded-full px-3.5 py-1.5 transition-colors",
          isActive("/") ? "bg-ink-900 text-sand-50" : "hover:bg-stone-200/60 hover:text-ink-900",
        ]}
      >
        Explore
      </a>
      <a
        href="/saved"
        class:list={[
          "rounded-full px-3.5 py-1.5 transition-colors",
          isActive("/saved") ? "bg-ink-900 text-sand-50" : "hover:bg-stone-200/60 hover:text-ink-900",
        ]}
      >
        Saved
      </a>
    </nav>
  </div>
</header>
