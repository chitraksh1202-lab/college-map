---
import { BRAND_NAME } from "@/lib/site";

const currentPath = Astro.url.pathname;
function isActive(path: string) {
  return path === "/" ? currentPath === "/" : currentPath.startsWith(path);
}
---

<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-sand-50/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 md:px-8">
    <a href="/" class="font-display text-[1.15rem] font-semibold tracking-tight text-ink-900">
      {BRAND_NAME.split(" ")[0]}<span class="text-ember-500">{BRAND_NAME.split(" ").slice(1).join(" ")}</span>
    </a>
    <nav class="flex items-center gap-1 text-[0.9rem] font-medium text-ink-700">
      <a
        href="/"
        class:list={[
          "rounded-full px-3.5 py-1.5 transition-colors",
          isActive("/") ? "bg-ink-900 text-sand-50" : "hover:bg-stone-200/60 hover:text-ink-900",
        ]}
      >
        Explore
      </a>
      <a
        href="/atlas"
        class:list={[
          "rounded-full px-3.5 py-1.5 transition-colors",
          isActive("/atlas") ? "bg-ink-900 text-sand-50" : "hover:bg-stone-200/60 hover:text-ink-900",
        ]}
      >
        My Atlas<span id="atlas-nav-count" class="ml-1 text-ink-500/70"></span>
      </a>
    </nav>
  </div>
</header>

<script>
  // Progressive enhancement only — the nav link works with zero JS.
  // Shows a subtle "· N" count next to "My Atlas" once we know how many
  // colleges are saved (localStorage is client-only, so this can't be
  // rendered server-side). Same event contract as the rest of the save
  // system — see src/lib/saved-colleges.ts.
  import { getSavedUnitIds, SAVED_COLLEGES_EVENT } from "@/lib/saved-colleges";

  const countEl = document.getElementById("atlas-nav-count");

  function renderCount() {
    if (!countEl) return;
    const count = getSavedUnitIds().length;
    countEl.textContent = count > 0 ? ` · ${count}` : "";
  }

  renderCount();
  window.addEventListener(SAVED_COLLEGES_EVENT, renderCount);
  window.addEventListener("storage", renderCount);
</script>
