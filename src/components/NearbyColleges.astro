---
import { getNearbyColleges } from "@/lib/colleges";
import { getDisplayName } from "@/lib/search";
import { formatMiles } from "@/lib/distance";

type Props = { slug: string };
const { slug } = Astro.props;

const nearby = getNearbyColleges(slug, 6);
---

{
  nearby.length > 0 && (
    <section aria-labelledby="nearby-heading" class="mx-auto max-w-5xl px-4 pb-16 md:px-8">
      <h2 id="nearby-heading" class="mb-3 font-display text-2xl font-semibold text-slate-900">
        Explore Colleges Nearby
      </h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {nearby.map(({ college, distanceMiles }) => (
          <li class="min-w-0">
            <a
              href={`/college/${college.slug}`}
              class="block min-w-0 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm transition hover:border-horizon-200 hover:shadow-md"
            >
              <p class="truncate font-display font-semibold text-slate-900">{getDisplayName(college)}</p>
              <p class="mt-1 text-sm text-slate-500">
                {college.city}, {college.stateCode} · {formatMiles(distanceMiles)} away
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
