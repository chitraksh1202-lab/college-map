---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MapExplorer from "@/components/MapExplorer.tsx";
import SearchBox from "@/components/SearchBox.tsx";
import TeleportButton from "@/components/TeleportButton.tsx";
import { getAllColleges, getAllCountries } from "@/lib/colleges";

const count = getAllColleges().length;
const countryCount = getAllCountries().length;
---

<BaseLayout
  title="College Explorer — Explore universities worldwide"
  description={`Explore ${count.toLocaleString()} universities and colleges across ${countryCount} countries like places, not rankings — an interactive world map, campus Street View, and playful discovery.`}
>
  <section class="mx-auto max-w-5xl px-4 pt-5 pb-3 text-center md:px-8 md:pt-6">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-ember-600">
      {count.toLocaleString()} universities · {countryCount} countries · one map
    </p>
    <h1 class="mx-auto mt-2 max-w-2xl font-display text-[2.15rem] font-semibold leading-[1.08] tracking-tight text-ink-900 md:text-5xl">
      Find a college you'd actually want to be at.
    </h1>
    <p class="mx-auto mt-1.5 hidden max-w-md text-[0.95rem] text-ink-500 sm:block md:text-base">
      Explore like it's a place, not a spreadsheet — then teleport somewhere you've never heard of.
    </p>

    <div class="mx-auto mt-4 flex max-w-2xl flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <SearchBox client:load dataUrl size="large" />
      <TeleportButton
        client:load
        className="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink-900 px-5 py-4 text-sm font-semibold text-sand-50 shadow-soft transition hover:bg-ink-800 active:scale-95"
      />
    </div>
  </section>

  <!-- The exploration canvas gets its own near-full-width container; the rest of the site stays constrained. -->
  <section class="mx-auto w-full px-2 pb-6 md:px-5">
    <MapExplorer client:load dataUrl world />
  </section>
</BaseLayout>
