---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MapExplorer from "@/components/MapExplorer.tsx";
import SearchBox from "@/components/SearchBox.tsx";
import TeleportButton from "@/components/TeleportButton.tsx";
import { getAllCollegePreviews, getAllSlugs } from "@/lib/colleges";

const colleges = getAllCollegePreviews();
const count = colleges.length;
const allSlugs = getAllSlugs();
---

<BaseLayout
  title="College Explorer — Explore colleges across America"
  description={`Explore ${count.toLocaleString()} US colleges like places, not rankings — an interactive map, campus Street View, and playful discovery.`}
>
  <section class="mx-auto max-w-5xl px-4 pt-7 pb-4 text-center md:px-8 md:pt-9">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-ember-600">
      {count.toLocaleString()} colleges · one map
    </p>
    <h1 class="mx-auto mt-2.5 max-w-2xl font-display text-[2.15rem] font-semibold leading-[1.08] tracking-tight text-ink-900 md:text-5xl">
      Find a college you'd actually want to be at.
    </h1>
    <p class="mx-auto mt-2.5 hidden max-w-md text-[0.95rem] text-ink-500 sm:block md:text-base">
      Explore like it's a place, not a spreadsheet — then teleport somewhere you've never heard of.
    </p>

    <div class="mx-auto mt-5 flex max-w-2xl flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <SearchBox client:load colleges={colleges} size="large" />
      <TeleportButton
        client:load
        allSlugs={allSlugs}
        className="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink-900 px-5 py-4 text-sm font-semibold text-sand-50 shadow-soft transition hover:bg-ink-800 active:scale-95"
      />
    </div>
  </section>

  <section class="mx-auto max-w-[1680px] px-2 pb-8 md:px-5">
    <MapExplorer client:load colleges={colleges} national />
  </section>
</BaseLayout>
