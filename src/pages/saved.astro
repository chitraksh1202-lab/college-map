---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SavedCollegesList from "@/components/SavedCollegesList.tsx";
import { getAllCollegePreviews } from "@/lib/colleges";
import { BRAND_NAME } from "@/lib/site";

const colleges = getAllCollegePreviews();
---

<BaseLayout title={`Saved colleges — ${BRAND_NAME}`} noindex>
  <section class="mx-auto max-w-5xl px-4 pt-9 pb-6 md:px-8 md:pt-14">
    <h1 class="font-display text-4xl font-semibold tracking-tight text-ink-900 md:text-5xl">
      Saved
    </h1>
    <p class="mt-2 text-ink-500">Colleges you've bookmarked to think about later.</p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16 md:px-8">
    <SavedCollegesList client:load colleges={colleges} />
  </section>
</BaseLayout>
