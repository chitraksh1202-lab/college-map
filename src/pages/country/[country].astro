---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MapExplorer from "@/components/MapExplorer.tsx";
import { getAllCountries, getCollegesByCountry, getCollegePreviewsByCountry } from "@/lib/colleges";
import { getDisplayName } from "@/lib/search";
import { countrySlugFor } from "@/lib/geo";
import { BRAND_NAME } from "@/lib/site";

export function getStaticPaths() {
  return getAllCountries().map((country) => ({
    params: { country: countrySlugFor(country.countryName) },
    props: country,
  }));
}

type Props = { countryCode: string; countryName: string; continent: string; count: number };

const { countryCode, countryName } = Astro.props;
const colleges = getCollegesByCountry(countryCode).sort((a, b) => a.name.localeCompare(b.name));
const mapColleges = getCollegePreviewsByCountry(countryCode);
---

<BaseLayout
  title={`Universities in ${countryName} — ${BRAND_NAME}`}
  description={`Explore ${colleges.length} universities in ${countryName}: interactive map and institution details.`}
>
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-5 md:px-8 md:pt-12">
    <p class="text-sm font-medium text-ember-600">
      <a href="/" class="hover:underline">← World</a>
    </p>
    <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight text-ink-900 md:text-5xl">
      {countryName}
    </h1>
    <p class="mt-2 text-ink-500">
      {colleges.length} institution{colleges.length === 1 ? "" : "s"} to explore.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-3 pb-10 md:px-8">
    <MapExplorer client:load colleges={mapColleges} />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-8">
    <h2 class="mb-2 font-display text-xl font-semibold text-ink-900">Every institution</h2>
    <ul class="divide-y divide-stone-200 border-t border-stone-200">
      {
        colleges.map((college) => (
          <li class="min-w-0">
            <a
              href={`/college/${college.slug}`}
              class="group flex items-center justify-between gap-4 py-3.5 transition-colors hover:bg-sand-100/70 sm:rounded-xl sm:px-3"
            >
              <div class="min-w-0">
                <p class="truncate font-medium text-ink-800 group-hover:text-ink-900">
                  {getDisplayName(college)}
                </p>
                <p class="mt-0.5 truncate text-sm text-ink-500">{college.city}</p>
              </div>
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="none"
                class="h-4 w-4 shrink-0 text-stone-400 transition group-hover:translate-x-0.5 group-hover:text-ember-500"
              >
                <path d="M7.5 4.5L13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
