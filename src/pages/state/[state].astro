---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MapExplorer from "@/components/MapExplorer.tsx";
import { getAllColleges, getCollegesByState, getCollegePreviewsByState } from "@/lib/colleges";
import { getDisplayName } from "@/lib/search";
import { formatOwnership } from "@/lib/format";

export function getStaticPaths() {
  const colleges = getAllColleges();
  const stateSlugs = new Map<string, { stateCode: string; stateName: string }>();
  for (const college of colleges) {
    const slug = college.state.toLowerCase().replace(/\s+/g, "-");
    if (!stateSlugs.has(slug)) {
      stateSlugs.set(slug, { stateCode: college.stateCode, stateName: college.state });
    }
  }
  return Array.from(stateSlugs.entries()).map(([slug, value]) => ({
    params: { state: slug },
    props: value,
  }));
}

type Props = { stateCode: string; stateName: string };

const { stateCode, stateName } = Astro.props;
const colleges = getCollegesByState(stateCode).sort((a, b) => a.name.localeCompare(b.name));
const mapColleges = getCollegePreviewsByState(stateCode);
---

<BaseLayout
  title={`Colleges in ${stateName} — College Explorer`}
  description={`Explore ${colleges.length} colleges in ${stateName}: interactive map, campus details, and Street View.`}
>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-6 md:px-8 md:pt-16">
    <p class="text-sm font-medium text-horizon-600">
      <a href="/" class="hover:underline">← All colleges</a>
    </p>
    <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-slate-900 md:text-4xl">
      Colleges in {stateName}
    </h1>
    <p class="mt-2 text-slate-500">
      {colleges.length} college{colleges.length === 1 ? "" : "s"} in {stateName}.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10 md:px-8">
    <MapExplorer client:load colleges={mapColleges} />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-8">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 class="font-display text-xl font-semibold text-slate-900">All colleges</h2>
      <label class="text-sm text-slate-500">
        Sort by{" "}
        <select
          id="state-college-sort"
          class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-sm text-slate-700"
        >
          <option value="name">Name (A–Z)</option>
          <option value="enrollment">Enrollment (largest first)</option>
          <option value="admissionRate">Admission rate (lowest first)</option>
        </select>
      </label>
    </div>

    <ul id="state-college-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        colleges.map((college) => (
          <li
            class="min-w-0"
            data-name={getDisplayName(college)}
            data-enrollment={college.undergraduateEnrollment ?? ""}
            data-admission-rate={college.admissionRate ?? ""}
          >
            <a
              href={`/college/${college.slug}`}
              class="block min-w-0 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm transition hover:border-horizon-200 hover:shadow-md"
            >
              <p class="truncate font-display font-semibold text-slate-900">{getDisplayName(college)}</p>
              <p class="mt-1 text-sm text-slate-500">
                {college.city}, {college.stateCode} · {formatOwnership(college.ownership)}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  // Client-side re-sort of the already-rendered list — no re-fetch, no
  // server round trip. Missing values always sort to the end regardless
  // of sort direction ("missing data should sort gracefully").
  const select = document.getElementById("state-college-sort") as HTMLSelectElement | null;
  const list = document.getElementById("state-college-list");

  function sortBy(key: string) {
    if (!list) return;
    const items = Array.from(list.children) as HTMLLIElement[];

    const withValue = (el: HTMLLIElement, attr: string) => {
      const raw = el.dataset[attr];
      return raw === undefined || raw === "" ? null : Number(raw);
    };

    items.sort((a, b) => {
      if (key === "name") {
        return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
      }
      const attr = key === "enrollment" ? "enrollment" : "admissionRate";
      const av = withValue(a, attr);
      const bv = withValue(b, attr);
      if (av === null && bv === null) return 0;
      if (av === null) return 1;
      if (bv === null) return -1;
      return key === "enrollment" ? bv - av : av - bv;
    });

    for (const item of items) list.appendChild(item);
  }

  select?.addEventListener("change", () => sortBy(select.value));
</script>
