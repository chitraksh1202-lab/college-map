---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MapExplorer from "@/components/MapExplorer.tsx";
import { getAllColleges, getCollegesByState } from "@/lib/colleges";
import { formatOwnership } from "@/lib/format";

export function getStaticPaths() {
  const colleges = getAllColleges();
  const stateSlugs = new Map<string, { stateCode: string; stateName: string }>();
  for (const college of colleges) {
    const slug = college.state.toLowerCase().replace(/\s+/g, "-");
    if (!stateSlugs.has(slug)) {
      stateSlugs.set(slug, { stateCode: college.stateCode, stateName: college.state });
    }
  }
  return Array.from(stateSlugs.entries()).map(([slug, value]) => ({
    params: { state: slug },
    props: value,
  }));
}

type Props = { stateCode: string; stateName: string };

const { stateCode, stateName } = Astro.props;
const colleges = getCollegesByState(stateCode);
---

<BaseLayout title={`Colleges in ${stateName} — College Explorer`}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-6 md:px-8 md:pt-16">
    <p class="text-sm font-medium text-horizon-600">
      <a href="/" class="hover:underline">← All colleges</a>
    </p>
    <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-slate-900 md:text-4xl">
      Colleges in {stateName}
    </h1>
    <p class="mt-2 text-slate-500">
      {colleges.length} college{colleges.length === 1 ? "" : "s"} in our test dataset for {stateName}.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10 md:px-8">
    <MapExplorer client:load colleges={colleges} />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-8">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        colleges.map((college) => (
          <li>
            <a
              href={`/college/${college.slug}`}
              class="block rounded-2xl border border-slate-100 bg-white p-4 shadow-sm transition hover:border-horizon-200 hover:shadow-md"
            >
              <p class="font-display font-semibold text-slate-900">{college.name}</p>
              <p class="mt-1 text-sm text-slate-500">
                {college.city}, {college.stateCode} · {formatOwnership(college.ownership)}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
