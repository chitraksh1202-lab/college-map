# Public key for Google Maps Embed API (Street View / campus maps).
# Restrict this key by HTTP referrer in Google Cloud Console.
# https://developers.google.com/maps/documentation/embed/get-api-key
PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional override for `npm run data:import`. The importer normally
# discovers the current "Most Recent Institution-Level Data" ZIP URL by
# reading https://collegescorecard.ed.gov/data/ (the filename is
# date-stamped and changes periodically). No API key is needed — the bulk
# download is public. Only set this if that page's structure changes and
# automatic discovery breaks.
COLLEGE_SCORECARD_ZIP_URL=
